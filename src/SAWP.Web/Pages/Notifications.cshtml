@page
@model NotificationsModel
@{
    ViewData["Title"] = "Trung tâm thông báo";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Thông báo trong hệ thống</h1>
        <div class="page-subtitle">Cập nhật tiến độ xử lý hồ sơ, thông báo trường học và phân công tác nghiệp</div>
    </div>
    <div class="page-actions">
        @if (Model.NotificationsList.Any(n => !n.IsRead))
        {
            <form method="post" asp-page-handler="MarkAllRead" style="margin:0;">
                <button type="submit" class="btn btn-outline">
                    <icon name="check" size="sm" /> Đánh dấu tất cả là đã đọc (MSG37)
                </button>
            </form>
        }
    </div>
</div>

<div class="sticker-card" style="max-width: 800px;">
    @if (Model.NotificationsList.Any())
    {
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var n in Model.NotificationsList)
            {
                <div style="padding: 1.25rem; border-radius: var(--radius-md); border: var(--border-solid); background-color: @(n.IsRead ? "#FFFFFF" : "#FAF5FF"); box-shadow: 2px 2px 0px var(--border-dark); display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                            @if (!n.IsRead)
                            {
                                <span class="badge badge-pink" style="padding: 0.1rem 0.4rem; font-size: 0.7rem;">Mới</span>
                            }
                            <h4 style="font-size: 1.05rem; margin: 0;">@n.Title</h4>
                            <span style="font-size: 0.8rem; color: var(--fg-muted);">
                                @Model.FormatDateTime(n.CreatedAt)
                            </span>
                        </div>
                        <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 0.5rem;">
                            @n.Message
                        </p>
                        @if (!string.IsNullOrEmpty(n.LinkUrl))
                        {
                            <a href="@n.LinkUrl" class="btn btn-sm btn-outline">
                                Xem chi tiết tác vụ <icon name="chevron-right" size="sm" />
                            </a>
                        }
                    </div>

                    @if (!n.IsRead)
                    {
                        <form method="post" asp-page-handler="MarkRead" asp-route-id="@n.Id" style="margin: 0;">
                            <button type="submit" class="btn btn-sm btn-ghost" title="Đánh dấu đã đọc">
                                <icon name="check" size="sm" />
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <icon name="bell" tone="violet" size="xl" class="empty-icon" />
            <div class="empty-title">Không có thông báo nào</div>
            <div class="empty-desc">Bạn đã đọc hết mọi thông báo trong hệ thống.</div>
        </div>
    }
</div>
