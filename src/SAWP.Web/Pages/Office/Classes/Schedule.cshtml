@page
@model ScheduleModel
@{
    ViewData["Title"] = $"Thời khóa biểu Lớp {Model.Class.Name}";
    Layout = "_AppLayout";

    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
    string DayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Thứ Hai",
        DayOfWeek.Tuesday => "Thứ Ba",
        DayOfWeek.Wednesday => "Thứ Tư",
        DayOfWeek.Thursday => "Thứ Năm",
        DayOfWeek.Friday => "Thứ Sáu",
        _ => d.ToString()
    };
}

<div class="page-head">
    <div>
        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
            <a href="/Office/Classes/Index" style="font-size:0.85rem; color:var(--fg-muted);">Lớp học</a>
            <span style="color:var(--fg-muted);">&rsaquo;</span>
            <span style="font-size:0.85rem; font-weight:700;">Thời khóa biểu</span>
        </div>
        <h1 class="page-title">Thời khóa biểu: Lớp @Model.Class.Name (UC-18)</h1>
        <div class="page-subtitle">Thiết lập lịch học theo tuần từ Thứ Hai đến Thứ Sáu, quản lý giáo viên bộ môn và phòng học</div>
    </div>
</div>

<div style="display: flex; flex-direction: column; gap: 2rem;">
    <!-- Timetable Grid -->
    <div class="sticker-card">
        <div class="card-header">
            <h3 class="card-title">
                <icon name="clock" shape="squircle" tone="violet" size="md" /> Lịch học trong tuần
            </h3>
        </div>

        <div class="table-container">
            <table class="table-pop" style="text-align: center;">
                <thead>
                    <tr>
                        <th style="width: 100px;">Tiết học</th>
                        @foreach (var d in days)
                        {
                            <th>@DayName(d)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int p = 1; p <= 8; p++)
                    {
                        var periodNum = p;
                        <tr>
                            <td style="font-weight: 700; background-color: #F8FAFC;">
                                Tiết @periodNum
                                <div style="font-size: 0.75rem; color: var(--fg-muted); font-weight: 500;">
                                    @(periodNum <= 4 ? "Buổi sáng" : "Buổi chiều")
                                </div>
                            </td>

                            @foreach (var d in days)
                            {
                                var slot = Model.ScheduleEntries.FirstOrDefault(s => s.DayOfWeek == d && s.PeriodNumber == periodNum);
                                <td style="padding: 0.75rem 0.5rem; vertical-align: top;">
                                    @if (slot != null)
                                    {
                                        <div style="background-color: #FAF5FF; border: 1.5px solid var(--accent-violet); border-radius: var(--radius-sm); padding: 0.5rem; box-shadow: 2px 2px 0px var(--accent-violet); position: relative; text-align: left;">
                                            <div style="font-weight: 700; font-size: 0.95rem; color: var(--accent-violet);">
                                                @slot.SubjectName
                                            </div>
                                            <div style="font-size: 0.8rem; color: var(--fg-muted); margin-top: 0.15rem;">
                                                @(slot.TeacherName ?? "GV bộ môn")
                                            </div>
                                            @if (!string.IsNullOrEmpty(slot.Room))
                                            {
                                                <div style="font-size: 0.75rem; color: var(--fg-subtle);">
                                                    Phòng: @slot.Room
                                                </div>
                                            }
                                            <form method="post" asp-page-handler="DeleteSlot" asp-route-slotId="@slot.Id" onsubmit="return confirm('Xóa tiết này?');" style="margin-top: 0.35rem; text-align: right;">
                                                <button type="submit" class="btn btn-sm btn-ghost" style="padding: 2px 4px;" title="Xóa tiết học">
                                                    <icon name="trash" size="sm" tone="danger" />
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="color: var(--fg-subtle); font-size: 0.85rem; padding: 0.5rem; border: 1px dashed var(--border-light); border-radius: var(--radius-sm);">
                                            Trống
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add / Update Period Slot Form -->
    <div class="sticker-card" style="max-width: 720px;">
        <div class="card-header">
            <h3 class="card-title">
                <icon name="plus" shape="squircle" tone="mint" size="md" /> Thêm / Cập nhật Tiết học
            </h3>
        </div>

        <form method="post" asp-page-handler="AddSlot">
            <input type="hidden" asp-for="ClassId" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="field">
                    <label class="field-label" for="dow">Thứ trong tuần (*)</label>
                    <select asp-for="DayOfWeek" id="dow" class="select">
                        <option value="1">Thứ Hai</option>
                        <option value="2">Thứ Ba</option>
                        <option value="3">Thứ Tư</option>
                        <option value="4">Thứ Năm</option>
                        <option value="5">Thứ Sáu</option>
                    </select>
                </div>

                <div class="field">
                    <label class="field-label" for="period">Tiết học (1..8) (*)</label>
                    <select asp-for="PeriodNumber" id="period" class="select">
                        <option value="1">Tiết 1 (Sáng)</option>
                        <option value="2">Tiết 2 (Sáng)</option>
                        <option value="3">Tiết 3 (Sáng)</option>
                        <option value="4">Tiết 4 (Sáng)</option>
                        <option value="5">Tiết 5 (Chiều)</option>
                        <option value="6">Tiết 6 (Chiều)</option>
                        <option value="7">Tiết 7 (Chiều)</option>
                        <option value="8">Tiết 8 (Chiều)</option>
                    </select>
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="sub">Môn học / Hoạt động (*)</label>
                <input asp-for="SubjectName" id="sub" class="input" placeholder="ví dụ: Tiếng Việt, Toán, Mỹ thuật, Âm nhạc..." required />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="field">
                    <label class="field-label" for="tName">Giáo viên giảng dạy</label>
                    <input asp-for="TeacherName" id="tName" class="input" placeholder="Tên giáo viên bộ môn..." />
                </div>

                <div class="field">
                    <label class="field-label" for="room">Phòng học</label>
                    <input asp-for="Room" id="room" class="input" placeholder="@(Model.Class.RoomNumber ?? "P.101")" />
                </div>
            </div>

            <button type="submit" class="btn btn-candy btn-lg" style="margin-top: 1rem;">
                <icon name="check" size="md" /> Lưu tiết học vào thời khóa biểu (BR-19)
            </button>
        </form>
    </div>
</div>
