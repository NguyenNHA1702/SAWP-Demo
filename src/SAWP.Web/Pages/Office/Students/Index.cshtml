@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ học sinh";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Quản lý Hồ sơ Học sinh (UC-06)</h1>
        <div class="page-subtitle">Danh bạ học sinh đã nhập học, thông tin phân lớp và thông tin người giám hộ</div>
    </div>
    <div class="page-actions" style="display:flex; gap:0.75rem;">
        <a href="/Office/Students/Import" class="btn btn-info">
            <icon name="upload" size="sm" /> Nhập tệp (UC-09)
        </a>
        <a href="/Office/Students/Create" class="btn btn-success">
            <icon name="plus" size="sm" /> Thêm học sinh (UC-07)
        </a>
    </div>
</div>

<!-- Grade Quick Navigation Tabs -->
<div class="tab-pills mb-4">
    <a href="/Office/Students/Index" class="tab-item @(Model.Grade == null ? "active active-violet" : "")">
        Tất cả khối
    </a>
    <a href="/Office/Students/Index?Grade=1" class="tab-item @(Model.Grade == 1 ? "active active-mint" : "")">
        Khối 1
    </a>
    <a href="/Office/Students/Index?Grade=2" class="tab-item @(Model.Grade == 2 ? "active active-amber" : "")">
        Khối 2
    </a>
    <a href="/Office/Students/Index?Grade=3" class="tab-item @(Model.Grade == 3 ? "active active-sky" : "")">
        Khối 3
    </a>
    <a href="/Office/Students/Index?Grade=4" class="tab-item @(Model.Grade == 4 ? "active active-pink" : "")">
        Khối 4
    </a>
    <a href="/Office/Students/Index?Grade=5" class="tab-item @(Model.Grade == 5 ? "active active-violet" : "")">
        Khối 5
    </a>
</div>

<!-- Filters Card -->
<div class="sticker-card" style="margin-bottom: 2rem; padding: 1.25rem;">
    <form method="get" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) auto; gap: 1rem; align-items: flex-end;">
        <div class="field" style="margin-bottom: 0;">
            <label class="field-label" for="search">Tìm kiếm</label>
            <input type="text" asp-for="Search" id="search" class="input" placeholder="Mã HS hoặc Họ tên..." />
        </div>

        <div class="field" style="margin-bottom: 0;">
            <label class="field-label" for="grade">Khối lớp</label>
            <select asp-for="Grade" id="grade" class="select">
                <option value="">Tất cả các khối</option>
                <option value="1">Khối 1</option>
                <option value="2">Khối 2</option>
                <option value="3">Khối 3</option>
                <option value="4">Khối 4</option>
                <option value="5">Khối 5</option>
            </select>
        </div>

        <div class="field" style="margin-bottom: 0;">
            <label class="field-label" for="classId">Lớp học</label>
            <select asp-for="ClassId" id="classId" class="select">
                <option value="">Tất cả các lớp</option>
                @foreach (var c in Model.AvailableClasses)
                {
                    <option value="@c.Id">Lớp @c.Name (Khối @c.Grade)</option>
                }
            </select>
        </div>

        <div class="field" style="margin-bottom: 0;">
            <label class="field-label" for="status">Trạng thái</label>
            <select asp-for="Status" id="status" class="select">
                <option value="">Tất cả trạng thái</option>
                <option value="Active">Đang học (Active)</option>
                <option value="Transferred">Đã chuyển trường</option>
                <option value="Graduated">Đã tốt nghiệp</option>
            </select>
        </div>

        <div style="display:flex; gap:0.5rem;">
            <button type="submit" class="btn btn-candy">
                <icon name="search" size="sm" /> Lọc
            </button>
            <a href="/Office/Students/Index" class="btn btn-outline" title="Đặt lại bộ lọc">
                <icon name="refresh-cw" size="sm" />
            </a>
        </div>
    </form>
</div>

<!-- Students Table -->
<div class="table-container">
    @if (Model.Students.Any())
    {
        <table class="table-pop">
            <thead>
                <tr>
                    <th>Mã HS</th>
                    <th>Họ và tên</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Lớp hiện tại</th>
                    <th>Phụ huynh chính</th>
                    <th>SĐT Liên hệ</th>
                    <th>Trạng thái</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td><code>@s.StudentCode</code></td>
                        <td><strong>@s.FullName</strong></td>
                        <td>@(s.Gender == Gender.Male ? "Nam" : s.Gender == Gender.Female ? "Nữ" : "Khác")</td>
                        <td>@Model.FormatDate(s.DateOfBirth)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(s.ClassName))
                            {
                                <span class="badge badge-violet">Lớp @s.ClassName</span>
                            }
                            else
                            {
                                <span class="badge badge-slate">Chưa phân lớp</span>
                            }
                        </td>
                        <td>@s.PrimaryGuardianName</td>
                        <td><code>@s.PrimaryGuardianPhone</code></td>
                        <td>
                            @if (s.Status == "Active")
                            {
                                <span class="badge badge-mint">Đang học</span>
                            }
                            else
                            {
                                <span class="badge badge-slate">@s.Status</span>
                            }
                        </td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 0.35rem;">
                                <a href="/Office/Students/Detail?id=@s.Id" class="btn btn-sm btn-soft-sky" title="Xem chi tiết">
                                    <icon name="user" size="sm" />
                                </a>
                                <a href="/Office/Students/Edit?id=@s.Id" class="btn btn-sm btn-soft-violet" title="Chỉnh sửa">
                                    <icon name="edit" size="sm" />
                                </a>
                                <a href="/Office/Students/Guardians?id=@s.Id" class="btn btn-sm btn-soft-mint" title="Quản lý phụ huynh">
                                    <icon name="users" size="sm" />
                                </a>
                                <a href="/Office/Students/History?id=@s.Id" class="btn btn-sm btn-soft-amber" title="Lịch sử hành chính">
                                    <icon name="clock" size="sm" />
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <icon name="search" tone="slate" size="xl" class="empty-icon" />
            <div class="empty-title">Không tìm thấy học sinh nào</div>
            <div class="empty-desc">Vui lòng thử tìm kiếm với từ khóa khác hoặc bỏ các bộ lọc để xem toàn bộ danh sách.</div>
        </div>
    }
</div>
