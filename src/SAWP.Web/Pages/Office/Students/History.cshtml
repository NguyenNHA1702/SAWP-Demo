@page
@model HistoryModel
@{
    ViewData["Title"] = $"Lịch sử hành chính: {Model.Student.FullName}";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
            <a href="/Office/Students/Index" style="font-size:0.85rem; color:var(--fg-muted);">Hồ sơ học sinh</a>
            <span style="color:var(--fg-muted);">&rsaquo;</span>
            <a href="/Office/Students/Detail?id=@Model.Student.Id" style="font-size:0.85rem; color:var(--fg-muted);">@Model.Student.FullName</a>
            <span style="color:var(--fg-muted);">&rsaquo;</span>
            <span style="font-size:0.85rem; font-weight:700;">Lịch sử hành chính</span>
        </div>
        <h1 class="page-title">Lịch sử Hành chính Học sinh (UC-12)</h1>
        <div class="page-subtitle">Dòng thời gian toàn diện các mốc sự kiện hành chính, phân lớp và thủ tục (BR-55)</div>
    </div>
</div>

<div style="max-width: 760px; margin: 0 auto;">
    <div class="sticker-card">
        <div class="card-header" style="margin-bottom: 2rem;">
            <h3 class="card-title">
                <icon name="clock" shape="squircle" tone="violet" size="md" /> Nhật ký sự kiện của @Model.Student.FullName (Mã: <code>@Model.Student.StudentCode</code>)
            </h3>
        </div>

        @if (Model.TimelineEvents.Any())
        {
            <div class="timeline">
                @foreach (var ev in Model.TimelineEvents)
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                <span class="badge @ev.BadgeClass">@ev.EventType</span>
                                <span style="font-size: 0.8rem; color: var(--fg-muted); font-weight: 600;">
                                    @Model.FormatDate(ev.Timestamp)
                                </span>
                            </div>
                            <h4 style="font-size: 1.05rem; margin-bottom: 0.35rem;">@ev.Title</h4>
                            <p style="font-size: 0.9rem; color: var(--fg-muted); margin: 0;">
                                @ev.Description
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-title">Chưa có sự kiện nào</div>
                <div class="empty-desc">Lịch sử hành chính sẽ hiển thị tại đây khi học sinh có các biến động học tập.</div>
            </div>
        }
    </div>
</div>
