@page
@model SAWP.Web.Pages.Service.Lunch.DailyModel
@{
    ViewData["Title"] = "Danh sách suất ăn hàng ngày";
}

<div class="page-header d-flex justify-between align-center mb-6">
    <div>
        <div class="breadcrumb mb-1">
            <a asp-page="/Service/Index">Bếp bán trú</a> &rsaquo; 
            <span>Suất ăn hàng ngày</span>
        </div>
        <h1 class="page-title">Suất ăn hàng ngày &ndash; @Model.Date.ToString("dd/MM/yyyy")</h1>
        <p class="text-muted">Tổng hợp số lượng suất ăn theo lớp và danh sách chi tiết học sinh (UC-33, UC-34, BR-32)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Service/Lunch/Menu" class="btn btn-secondary">
            <icon name="calendar" /> Lịch ăn & Thực đơn
        </a>
        <a asp-page="/Service/Lunch/Reports" class="btn btn-candy">
            <icon name="bar-chart-2" /> Báo cáo suất ăn
        </a>
        <button type="button" class="btn btn-ghost" onclick="window.print()">
            <icon name="printer" /> In danh sách bếp
        </button>
    </div>
</div>

<!-- Date & Class Filter -->
<div class="app-card mb-6">
    <div class="card-body py-3">
        <form method="get" class="d-flex gap-4 align-center flex-wrap">
            <div class="form-group mb-0" style="min-width: 170px;">
                <label class="form-label text-xs mb-1">Chọn ngày phục vụ</label>
                <input type="date" asp-for="Date" class="form-control form-control-sm" onchange="this.form.submit()" />
            </div>

            <div class="form-group mb-0" style="min-width: 180px;">
                <label class="form-label text-xs mb-1">Lọc theo lớp</label>
                <select asp-for="ClassId" class="form-control form-control-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả các lớp --</option>
                    @foreach (var c in Model.AvailableClasses)
                    {
                        <option value="@c.Id">Lớp @c.Name (Khối @c.Grade)</option>
                    }
                </select>
            </div>

            <div class="d-flex align-end gap-2" style="margin-top: 1.3rem;">
                <button type="submit" class="btn btn-primary btn-sm">
                    <icon name="search" /> Xem danh sách
                </button>
                <a asp-page="/Service/Lunch/Daily" asp-route-date="@Model.Clock.Today.ToString("yyyy-MM-dd")" class="btn btn-ghost btn-sm">Hôm nay</a>
            </div>
        </form>
    </div>
</div>

<!-- Kitchen Preparation Key Metrics -->
<div class="grid grid-3 gap-4 mb-6">
    <div class="stat-sticker">
        <div class="stat-icon bg-lavender-subtle">
            <icon name="utensils" class="text-primary" />
        </div>
        <div>
            <div class="stat-label">Tổng suất ăn cần nấu</div>
            <div class="stat-value font-mono">@Model.TotalMeals <span class="text-xs font-normal">suất</span></div>
        </div>
    </div>

    <div class="stat-sticker">
        <div class="stat-icon @(Model.IsPastCutoff ? "bg-danger-subtle" : "bg-mint-subtle")">
            <icon name="clock" class="@(Model.IsPastCutoff ? "text-danger" : "text-mint")" />
        </div>
        <div>
            <div class="stat-label">Hạn chốt tự hủy (BR-28)</div>
            <div class="stat-value text-base font-semibold">
                @(Model.IsPastCutoff ? "Đã chốt sổ bếp" : "Đang mở nhận")
            </div>
            <span class="text-xs text-muted">Hạn 08:00 sáng hàng ngày</span>
        </div>
    </div>

    <div class="stat-sticker">
        <div class="stat-icon bg-peach-subtle">
            <icon name="file-text" class="text-warning" />
        </div>
        <div>
            <div class="stat-label">Thực đơn hôm nay</div>
            <div class="text-xs font-medium text-secondary text-truncate" style="max-width: 250px;">
                @(Model.ServiceDay?.MenuDescription ?? "Thực đơn dinh dưỡng tiêu chuẩn")
            </div>
        </div>
    </div>
</div>

<!-- Class Breakdown Matrix (BR-32 Kitchen distribution sheet) -->
<div class="app-card mb-6">
    <div class="card-header bg-light">
        <h3 class="card-title text-sm font-semibold d-flex align-center gap-2">
            <icon name="layers" class="text-secondary" /> Phân bổ suất ăn theo từng lớp (BR-32 Bảng chia cơm bán trú)
        </h3>
    </div>
    <div class="card-body">
        <div class="grid grid-5 gap-3">
            @foreach (var cc in Model.ClassCounts)
            {
                <div class="p-3 bg-light rounded text-center" style="border: 2px solid var(--border-color);">
                    <div class="text-xs text-muted mb-1 font-bold">Lớp @cc.ClassName</div>
                    <div class="font-mono text-xl font-extrabold text-primary">@cc.RegisteredCount</div>
                    <div class="text-xs text-muted">/ @cc.TotalStudents học sinh</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Detailed Student Lunch Table -->
<div class="app-card">
    <div class="card-header d-flex justify-between align-center">
        <h2 class="card-title text-base font-semibold d-flex align-center gap-2">
            <icon name="list" class="text-primary" /> Danh sách học sinh đăng ký (@Model.StudentMeals.Count)
        </h2>
    </div>

    @if (!Model.StudentMeals.Any())
    {
        <div class="card-body text-center py-6 text-muted">
            Không có dữ liệu đăng ký ăn trưa cho ngày hoặc lớp đã chọn.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-pop">
                <thead>
                    <tr>
                        <th>Lớp</th>
                        <th>Mã học sinh</th>
                        <th>Họ và tên</th>
                        <th>Trạng thái</th>
                        <th>Thời gian đăng ký</th>
                        <th>Ghi chú điều chỉnh (BR-31)</th>
                        <th class="text-right">Thao tác bếp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.StudentMeals)
                    {
                        <tr>
                            <td>
                                <span class="badge badge-primary font-bold">Lớp @item.ClassName</span>
                            </td>
                            <td class="font-mono font-bold text-sm">@item.StudentCode</td>
                            <td class="font-semibold">@item.FullName</td>
                            <td>
                                @if (item.Status == SAWP.Web.Domain.LunchRegistrationStatus.Registered)
                                {
                                    <span class="badge badge-success"><icon name="check" /> Có suất ăn</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning"><icon name="slash" /> Đã hủy suất</span>
                                }
                            </td>
                            <td class="text-xs text-muted font-mono">
                                @item.RegisteredAt.ToLocalTime().ToString("dd/MM HH:mm")
                            </td>
                            <td class="text-xs" style="max-width: 250px;">
                                @if (!string.IsNullOrEmpty(item.AdjustmentReason))
                                {
                                    <span class="text-primary">@item.AdjustmentReason</span>
                                    @if (!string.IsNullOrEmpty(item.AdjustedByStaffName))
                                    {
                                        <div class="text-muted">Bởi: @item.AdjustedByStaffName</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-right">
                                @if (item.Status == SAWP.Web.Domain.LunchRegistrationStatus.Registered)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-xs" onclick="openAdjustModal(@item.StudentId, '@item.FullName', 'Cancel')">
                                        <icon name="x" /> Bếp hủy suất
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-candy btn-xs" onclick="openAdjustModal(@item.StudentId, '@item.FullName', 'Register')">
                                        <icon name="plus" /> Khôi phục suất
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Staff Adjustment (UC-34, BR-31) -->
<div id="adjustModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="app-card" style="max-width: 480px; width: 90%; margin: auto; animation: popIn 0.2s cubic-bezier(.34,1.56,.64,1);">
        <div class="card-header bg-lavender-subtle d-flex justify-between align-center">
            <h3 class="card-title text-base font-semibold d-flex align-center gap-2">
                <icon name="edit-3" class="text-primary" /> Nhân viên điều chỉnh suất ăn (BR-31)
            </h3>
            <button type="button" class="btn btn-ghost btn-xs" onclick="closeAdjustModal()">&times;</button>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="AdjustMeal">
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" id="adjustStudentId" />
                <input type="hidden" name="mealDate" value="@Model.Date.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="actionType" id="adjustActionType" />

                <p class="text-sm mb-3">
                    Điều chỉnh suất ăn ngày <strong>@Model.Date.ToString("dd/MM/yyyy")</strong> cho học sinh: <strong id="adjustStudentName"></strong>.
                </p>

                <div class="form-group mb-4">
                    <label class="form-label">Lý do điều chỉnh (bắt buộc theo BR-31) <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="3" placeholder="Ví dụ: Phụ huynh báo nghỉ ốm đột xuất qua điện thoại sau giờ chốt..." required></textarea>
                    <small class="text-muted">Mọi thao tác điều chỉnh sau giờ chốt sẽ được lưu vết kiểm toán và thông báo đến phụ huynh.</small>
                </div>

                <div class="d-flex justify-end gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="closeAdjustModal()">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <icon name="check" /> Xác nhận lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAdjustModal(studentId, studentName, actionType) {
            document.getElementById('adjustStudentId').value = studentId;
            document.getElementById('adjustStudentName').textContent = studentName;
            document.getElementById('adjustActionType').value = actionType;
            document.getElementById('adjustModal').style.display = 'flex';
        }

        function closeAdjustModal() {
            document.getElementById('adjustModal').style.display = 'none';
        }
    </script>
}
