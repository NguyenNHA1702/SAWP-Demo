@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_PublicLayout";
}

<div style="max-width: 480px; margin: 2rem auto;">
    <div class="sticker-card">
        <div style="text-align: center; margin-bottom: 2rem;">
            <icon name="shield" shape="squircle" tone="violet" size="xl" style="margin-bottom: 1rem;" />
            <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Thiết lập mật khẩu mới</h2>
            <p style="color: var(--fg-muted); font-size: 0.95rem;">
                Mật khẩu mới phải có ít nhất 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt (BR-02).
            </p>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="field">
                <label class="field-label" for="newPass">Mật khẩu mới</label>
                <input asp-for="NewPassword" id="newPass" type="password" class="input" placeholder="Nhập mật khẩu mới..." required />
            </div>

            <div class="field">
                <label class="field-label" for="confirmPass">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" id="confirmPass" type="password" class="input" placeholder="Nhập lại mật khẩu mới..." required />
            </div>

            <button type="submit" class="btn btn-candy btn-lg" style="width: 100%; margin-top: 1rem;">
                <icon name="check" size="md" /> Lưu mật khẩu & Đăng nhập
            </button>
        </form>
    </div>
</div>
