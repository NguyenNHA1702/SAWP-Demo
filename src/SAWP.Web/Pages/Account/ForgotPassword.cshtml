@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_PublicLayout";
}

<div style="max-width: 480px; margin: 2rem auto;">
    <div class="sticker-card">
        <div style="text-align: center; margin-bottom: 2rem;">
            <icon name="mail" shape="squircle" tone="violet" size="xl" style="margin-bottom: 1rem;" />
            <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Khôi phục mật khẩu</h2>
            <p style="color: var(--fg-muted); font-size: 0.95rem;">
                Nhập địa chỉ email liên kết với tài khoản để nhận mã xác thực OTP qua hệ thống.
            </p>
        </div>

        <form method="post">
            <div class="field">
                <label class="field-label" for="email">Địa chỉ Email đã đăng ký</label>
                <input asp-for="Email" id="email" type="email" class="input" placeholder="ví dụ: ph.nam@sawp.edu.vn" required />
            </div>

            <button type="submit" class="btn btn-candy btn-lg" style="width: 100%; margin-top: 1rem;">
                <icon name="mail" size="md" /> Gửi mã OTP xác thực
            </button>
        </form>

        <div style="margin-top: 1.5rem; text-align: center;">
            <a href="/Account/Login" style="font-size: 0.9rem;">
                <icon name="chevron-left" size="sm" /> Quay lại trang đăng nhập
            </a>
        </div>
    </div>
</div>
