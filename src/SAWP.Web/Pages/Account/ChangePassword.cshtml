@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Đổi mật khẩu tài khoản</h1>
        <div class="page-subtitle">Cập nhật mật khẩu định kỳ để bảo vệ quyền truy cập hệ thống</div>
    </div>
</div>

<div style="max-width: 480px; margin: 0 auto;">
    <div class="sticker-card">
        <form method="post">
            <div class="field">
                <label class="field-label" for="currPass">Mật khẩu hiện tại</label>
                <input asp-for="CurrentPassword" id="currPass" type="password" class="input" required />
            </div>

            <div class="field">
                <label class="field-label" for="newPass">Mật khẩu mới</label>
                <input asp-for="NewPassword" id="newPass" type="password" class="input" required />
                <span class="field-hint">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</span>
            </div>

            <div class="field">
                <label class="field-label" for="confirmPass">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" id="confirmPass" type="password" class="input" required />
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-candy btn-lg" style="flex: 1;">
                    <icon name="check" size="md" /> Cập nhật mật khẩu
                </button>
                <a href="/Account/Profile" class="btn btn-outline btn-lg">Hủy</a>
            </div>
        </form>
    </div>
</div>
