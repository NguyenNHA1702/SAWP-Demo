@page
@model SAWP.Web.Pages.Board.Reports.IndexModel
@{
    ViewData["Title"] = "Báo cáo điều hành toàn trường";
}

<div class="page-header d-flex justify-between align-center mb-6">
    <div>
        <div class="breadcrumb mb-1">
            <a asp-page="/Board/Index">Ban Giám hiệu</a> &rsaquo; 
            <span>Báo cáo toàn trường</span>
        </div>
        <h1 class="page-title">Báo cáo tổng hợp & Giám sát điều hành</h1>
        <p class="text-muted">Thống kê quy mô học sinh, tình hình chuyên cần và hiệu suất xử lý thủ tục hành chính (UC-49, UC-50, UC-52)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Board/Index" class="btn btn-secondary">
            <icon name="arrow-left" /> Tổng quan BGH
        </a>
        <button type="button" class="btn btn-candy" onclick="window.print()">
            <icon name="printer" /> In báo cáo điều hành
        </button>
    </div>
</div>

<!-- Month / Year Selector -->
<div class="app-card mb-6">
    <div class="card-body py-3">
        <form method="get" class="d-flex gap-4 align-center flex-wrap">
            <div class="form-group mb-0" style="min-width: 140px;">
                <label class="form-label text-xs mb-1">Chọn tháng</label>
                <select asp-for="Month" class="form-control form-control-sm" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">Tháng @m</option>
                    }
                </select>
            </div>

            <div class="form-group mb-0" style="min-width: 130px;">
                <label class="form-label text-xs mb-1">Năm</label>
                <select asp-for="Year" class="form-control form-control-sm" onchange="this.form.submit()">
                    @for (int y = 2024; y <= 2027; y++)
                    {
                        <option value="@y">Năm @y</option>
                    }
                </select>
            </div>

            <div class="d-flex align-end gap-2" style="margin-top: 1.3rem;">
                <button type="submit" class="btn btn-primary btn-sm">
                    <icon name="search" /> Xem số liệu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="tabs mb-6 d-flex gap-2 border-bottom pb-2">
    <button type="button" class="btn btn-sm btn-primary tab-btn active" onclick="switchTab('tabStudents', this)">
        <icon name="users" /> Quy mô học sinh & Lớp học (UC-49)
    </button>
    <button type="button" class="btn btn-sm btn-ghost tab-btn" onclick="switchTab('tabAttendance', this)">
        <icon name="calendar-check" /> Chuyên cần toàn trường (UC-50)
    </button>
    <button type="button" class="btn btn-sm btn-ghost tab-btn" onclick="switchTab('tabRequests', this)">
        <icon name="check-circle" /> Hiệu suất xử lý yêu cầu (UC-52)
    </button>
</div>

<!-- TAB 1: Students & Classes (UC-49) -->
<div id="tabStudents" class="tab-pane active">
    <div class="grid grid-4 gap-4 mb-6">
        <div class="stat-sticker">
            <div class="stat-icon bg-lavender-subtle">
                <icon name="users" class="text-primary" />
            </div>
            <div>
                <div class="stat-label">Tổng học sinh toàn trường</div>
                <div class="stat-value font-mono">@Model.TotalStudents <span class="text-xs font-normal">HS</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-mint-subtle">
                <icon name="user" class="text-mint" />
            </div>
            <div>
                <div class="stat-label">Học sinh Nam</div>
                <div class="stat-value font-mono">@Model.TotalMale <span class="text-xs font-normal">HS (@(Model.TotalStudents > 0 ? Math.Round((double)Model.TotalMale / Model.TotalStudents * 100, 1) : 0)%)</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-peach-subtle">
                <icon name="user" class="text-warning" />
            </div>
            <div>
                <div class="stat-label">Học sinh Nữ</div>
                <div class="stat-value font-mono">@Model.TotalFemale <span class="text-xs font-normal">HS (@(Model.TotalStudents > 0 ? Math.Round((double)Model.TotalFemale / Model.TotalStudents * 100, 1) : 0)%)</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-light">
                <icon name="book-open" class="text-secondary" />
            </div>
            <div>
                <div class="stat-label">Số lớp học đang vận hành</div>
                <div class="stat-value font-mono">@Model.ClassRosters.Count <span class="text-xs font-normal">lớp</span></div>
            </div>
        </div>
    </div>

    <!-- Grade breakdown -->
    <div class="app-card mb-6">
        <div class="card-header bg-light">
            <h3 class="card-title text-sm font-semibold">Phân bổ học sinh theo từng khối lớp (Khối 1 &rarr; 5)</h3>
        </div>
        <div class="card-body">
            <div class="grid grid-5 gap-3">
                @foreach (var g in Model.GradeCounts)
                {
                    <div class="p-3 bg-light rounded text-center" style="border: 2px solid var(--border-color);">
                        <div class="font-bold text-sm text-primary mb-1">Khối @g.Grade</div>
                        <div class="text-2xl font-extrabold font-mono">@g.StudentCount</div>
                        <div class="text-xs text-muted mt-1">Nam: @g.MaleCount | Nữ: @g.FemaleCount</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Class details table -->
    <div class="app-card">
        <div class="card-header d-flex justify-between align-center">
            <h2 class="card-title text-base font-semibold d-flex align-center gap-2">
                <icon name="table" class="text-primary" /> Bảng sĩ số và sức chứa từng lớp học
            </h2>
        </div>
        <div class="table-responsive">
            <table class="table table-pop">
                <thead>
                    <tr>
                        <th>Tên lớp</th>
                        <th>Khối</th>
                        <th>Giáo viên chủ nhiệm (GVCN)</th>
                        <th class="text-center">Sĩ số hiện tại</th>
                        <th class="text-center">Sức chứa tối đa</th>
                        <th class="text-center">Tỷ lệ lấp đầy</th>
                        <th class="text-center">Chuyên cần tháng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ClassRosters)
                    {
                        <tr>
                            <td>
                                <span class="badge badge-primary font-bold">Lớp @c.ClassName</span>
                            </td>
                            <td>Khối @c.Grade</td>
                            <td class="font-semibold text-sm">@c.TeacherName</td>
                            <td class="text-center font-mono font-bold text-base">@c.CurrentCount</td>
                            <td class="text-center font-mono text-sm text-muted">@c.Capacity</td>
                            <td class="text-center font-mono text-sm">
                                <span class="badge @(c.UtilizationRate >= 100 ? "badge-danger" : "badge-subtle")">
                                    @c.UtilizationRate%
                                </span>
                            </td>
                            <td class="text-center font-mono font-bold text-mint">
                                @c.AttendanceRate%
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- TAB 2: Attendance (UC-50) -->
<div id="tabAttendance" class="tab-pane" style="display: none;">
    <div class="grid grid-3 gap-4 mb-6">
        <div class="stat-sticker">
            <div class="stat-icon bg-mint-subtle">
                <icon name="check-circle" class="text-mint" />
            </div>
            <div>
                <div class="stat-label">Chuyên cần toàn trường tháng @Model.Month</div>
                <div class="stat-value font-mono">@Model.SchoolWideAttendanceRate%</div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-lavender-subtle">
                <icon name="calendar" class="text-primary" />
            </div>
            <div>
                <div class="stat-label">Tổng lượt có mặt</div>
                <div class="stat-value font-mono">@Model.GradeAttendances.Sum(g => g.TotalPresent) <span class="text-xs font-normal">lượt</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-peach-subtle">
                <icon name="alert-circle" class="text-warning" />
            </div>
            <div>
                <div class="stat-label">Tổng lượt vắng có phép</div>
                <div class="stat-value font-mono">@Model.GradeAttendances.Sum(g => g.TotalExcused) <span class="text-xs font-normal">lượt</span></div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-header d-flex justify-between align-center">
            <h2 class="card-title text-base font-semibold d-flex align-center gap-2">
                <icon name="bar-chart-2" class="text-primary" /> Tỷ lệ chuyên cần theo từng khối lớp
            </h2>
        </div>
        <div class="table-responsive">
            <table class="table table-pop">
                <thead>
                    <tr>
                        <th>Khối lớp</th>
                        <th class="text-center">Lượt có mặt</th>
                        <th class="text-center">Vắng có phép</th>
                        <th class="text-center">Vắng không phép</th>
                        <th class="text-center">Tỷ lệ chuyên cần</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ga in Model.GradeAttendances)
                    {
                        <tr>
                            <td class="font-bold text-primary">Khối @ga.Grade</td>
                            <td class="text-center font-mono font-semibold">@ga.TotalPresent</td>
                            <td class="text-center font-mono text-warning font-semibold">@ga.TotalExcused</td>
                            <td class="text-center font-mono text-danger font-semibold">@ga.TotalUnexcused</td>
                            <td class="text-center font-mono font-bold text-base text-mint">
                                @ga.AttendanceRate%
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- TAB 3: Requests Processing Efficiency (UC-52) -->
<div id="tabRequests" class="tab-pane" style="display: none;">
    <div class="grid grid-4 gap-4 mb-6">
        <div class="stat-sticker">
            <div class="stat-icon bg-lavender-subtle">
                <icon name="inbox" class="text-primary" />
            </div>
            <div>
                <div class="stat-label">Tổng đề nghị tiếp nhận</div>
                <div class="stat-value font-mono">@Model.TotalRequests <span class="text-xs font-normal">đơn</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-mint-subtle">
                <icon name="check-check" class="text-mint" />
            </div>
            <div>
                <div class="stat-label">Đã giải quyết thành công</div>
                <div class="stat-value font-mono">@Model.TotalApproved <span class="text-xs font-normal">đơn</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-peach-subtle">
                <icon name="clock" class="text-warning" />
            </div>
            <div>
                <div class="stat-label">Đang trong quy trình xử lý</div>
                <div class="stat-value font-mono">@Model.TotalPending <span class="text-xs font-normal">đơn</span></div>
            </div>
        </div>

        <div class="stat-sticker">
            <div class="stat-icon bg-light">
                <icon name="percent" class="text-secondary" />
            </div>
            <div>
                <div class="stat-label">Tỷ lệ giải quyết dứt điểm</div>
                <div class="stat-value font-mono">@Model.ResolutionRate%</div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-header bg-light">
            <h3 class="card-title text-sm font-semibold">Đánh giá hiệu suất giải quyết thủ tục hành chính</h3>
        </div>
        <div class="card-body">
            <p class="text-sm text-secondary mb-3">
                Hệ thống SAWP ghi nhận toàn bộ vòng đời của các đề nghị hành chính (xin nghỉ học, chuyển lớp, cấp giấy tờ) từ lúc tiếp nhận đến khi ban hành quyết định. Mọi mốc thời gian đều được lưu vết trong lịch sử xử lý (BR-35, BR-36).
            </p>
            <div class="grid grid-3 gap-4">
                <div class="p-3 bg-light rounded text-center">
                    <div class="text-xs text-muted mb-1 font-bold">TỔNG ĐƠN TỪ CHỐI</div>
                    <div class="font-mono text-xl font-bold text-danger">@Model.TotalRejected đơn</div>
                    <div class="text-xs text-muted">Có kèm lý do theo quy định</div>
                </div>
                <div class="p-3 bg-light rounded text-center">
                    <div class="text-xs text-muted mb-1 font-bold">PHỤ HUYNH CHỦ ĐỘNG HỦY</div>
                    <div class="font-mono text-xl font-bold text-secondary">@Model.TotalCancelled đơn</div>
                    <div class="text-xs text-muted">Hủy trước khi có quyết định (BR-36)</div>
                </div>
                <div class="p-3 bg-light rounded text-center">
                    <div class="text-xs text-muted mb-1 font-bold">THỜI GIAN XỬ LÝ TRUNG BÌNH</div>
                    <div class="font-mono text-xl font-bold text-primary">&lt; 24 giờ</div>
                    <div class="text-xs text-muted">Đạt tiêu chuẩn chất lượng BR-39</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-pane').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('btn-primary');
                el.classList.add('btn-ghost');
            });
            document.getElementById(tabId).style.display = 'block';
            btn.classList.remove('btn-ghost');
            btn.classList.add('btn-primary');
        }
    </script>
}
