@page
@model SAWP.Web.Pages.Teacher.Leave.IndexModel
@{
    ViewData["Title"] = "Duyệt đơn xin nghỉ học";
}

<div class="page-header d-flex justify-between align-center mb-6">
    <div>
        <div class="breadcrumb mb-1">
            <a asp-page="/Teacher/Index">Trang chủ GVCN</a> &rsaquo; 
            <a asp-page="/Teacher/Attendance/Index">Điểm danh</a> &rsaquo; 
            <span>Duyệt đơn xin nghỉ học</span>
        </div>
        <h1 class="page-title">Duyệt đơn xin nghỉ học &ndash; Lớp @Model.HomeroomClass?.Name</h1>
        <p class="text-muted">Xem xét và giải quyết đơn xin nghỉ phép của học sinh trong lớp phụ trách (UC-26)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Teacher/Attendance/Index" class="btn btn-secondary">
            <icon name="calendar-check" /> Sổ điểm danh
        </a>
        <a asp-page="/Teacher/Attendance/Summary" class="btn btn-candy">
            <icon name="bar-chart-2" /> Báo cáo chuyên cần
        </a>
    </div>
</div>

<!-- Rule notice -->
<div class="alert-box alert-info mb-6">
    <icon name="info" class="text-info" />
    <div class="text-sm">
        <strong>Thẩm quyền phê duyệt của GVCN (BR-25, BR-29, BR-41):</strong>
        Giáo viên chủ nhiệm phê duyệt các đơn xin nghỉ từ <strong>1 đến 3 ngày</strong>. Khi được phê duyệt, hệ thống sẽ tự động cập nhật trạng thái <em>Nghỉ có phép</em> trong sổ điểm danh và tự động hủy suất ăn bán trú tương ứng. Các đơn từ 4 ngày trở lên đã được hệ thống tự động chuyển tiếp lên Ban Giám hiệu xét duyệt (UC-27).
    </div>
</div>

<!-- Pending Requests -->
<div class="app-card mb-6">
    <div class="card-header d-flex justify-between align-center bg-lavender-subtle">
        <h2 class="card-title text-base font-semibold d-flex align-center gap-2">
            <icon name="clock" class="text-primary" /> Đơn chờ GVCN phê duyệt 
            <span class="badge badge-primary">@Model.PendingRequests.Count</span>
        </h2>
    </div>

    @if (!Model.PendingRequests.Any())
    {
        <div class="card-body text-center py-6">
            <div class="empty-state-icon mb-2">
                <icon name="check-circle" style="width: 44px; height: 44px;" class="text-mint" />
            </div>
            <h3 class="text-base font-semibold mb-1">Hiện không có đơn nào chờ duyệt!</h3>
            <p class="text-muted text-sm mb-0">Tất cả các đơn xin nghỉ của học sinh lớp @Model.HomeroomClass?.Name đã được xử lý xong.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-pop">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Học sinh</th>
                        <th>Thời gian xin nghỉ</th>
                        <th>Lý do phụ huynh gửi</th>
                        <th>Phụ huynh gửi</th>
                        <th class="text-right" style="min-width: 220px;">Thao tác xét duyệt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.PendingRequests)
                    {
                        var leave = req.LeaveRequest;
                        <tr>
                            <td>
                                <span class="font-mono font-bold text-primary">@req.RequestCode</span>
                                <div class="text-xs text-muted">@req.SubmittedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                            </td>
                            <td>
                                <div class="font-semibold text-base">@req.Student?.FullName</div>
                                <span class="badge badge-subtle text-xs">Mã: @req.Student?.StudentCode</span>
                            </td>
                            <td>
                                @if (leave != null)
                                {
                                    <div class="font-semibold text-primary">
                                        @leave.StartDate.ToString("dd/MM/yyyy") &rarr; @leave.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <span class="badge badge-warning text-xs mt-1">
                                        <icon name="calendar" /> Tổng: @leave.TotalDays ngày
                                    </span>
                                }
                            </td>
                            <td class="text-sm" style="max-width: 280px;">
                                <div class="p-2 bg-light rounded text-secondary" style="border-left: 3px solid var(--accent-violet);">
                                    @(leave?.Reason ?? "Không có lý do")
                                </div>
                            </td>
                            <td class="text-sm">
                                <div class="font-medium">@(req.RequesterGuardian?.FullName ?? "Phụ huynh")</div>
                                <div class="text-xs text-muted">SĐT: @(req.RequesterGuardian?.PhoneNumber ?? "—")</div>
                            </td>
                            <td class="text-right">
                                <div class="d-flex justify-end gap-2">
                                    <form method="post" asp-page-handler="Approve" asp-route-id="@req.Id" class="d-inline" onsubmit="return confirm('Chấp thuận cho học sinh @req.Student?.FullName nghỉ học theo đơn này? Hệ thống sẽ tự động cập nhật sổ điểm danh và suất ăn bán trú (BR-29).');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-candy btn-sm">
                                            <icon name="check" /> Duyệt đơn
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="openRejectModal(@req.Id, '@req.RequestCode', '@req.Student?.FullName')">
                                        <icon name="x" /> Từ chối
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Processed Requests History -->
<div class="app-card">
    <div class="card-header d-flex justify-between align-center">
        <h2 class="card-title text-base font-semibold d-flex align-center gap-2">
            <icon name="history" class="text-secondary" /> Lịch sử đơn đã giải quyết gần đây (@Model.ProcessedRequests.Count)
        </h2>
    </div>

    @if (!Model.ProcessedRequests.Any())
    {
        <div class="card-body text-center py-5 text-muted text-sm">
            Chưa có lịch sử đơn xin nghỉ nào trong học kỳ này.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-pop">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Học sinh</th>
                        <th>Khoảng thời gian</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú / Quyết định</th>
                        <th>Ngày cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.ProcessedRequests)
                    {
                        var leave = req.LeaveRequest;
                        <tr>
                            <td class="font-mono text-sm font-semibold">@req.RequestCode</td>
                            <td>
                                <div class="font-medium">@req.Student?.FullName</div>
                                <span class="text-xs text-muted">@req.Student?.StudentCode</span>
                            </td>
                            <td class="text-sm">
                                @if (leave != null)
                                {
                                    <span>@leave.StartDate.ToString("dd/MM/yyyy") - @leave.EndDate.ToString("dd/MM/yyyy")</span>
                                    <span class="text-muted text-xs">(@leave.TotalDays ngày)</span>
                                }
                            </td>
                            <td class="text-xs text-muted" style="max-width: 200px;">
                                @leave?.Reason
                            </td>
                            <td>
                                @switch (req.Status)
                                {
                                    case SAWP.Web.Domain.RequestStatus.Approved:
                                        <span class="badge badge-success"><icon name="check-circle" /> Đã duyệt</span>
                                        break;
                                    case SAWP.Web.Domain.RequestStatus.Rejected:
                                        <span class="badge badge-danger"><icon name="x-circle" /> Từ chối</span>
                                        break;
                                    case SAWP.Web.Domain.RequestStatus.Escalated:
                                        <span class="badge badge-warning"><icon name="arrow-up-circle" /> Chuyển BGH</span>
                                        break;
                                    case SAWP.Web.Domain.RequestStatus.Cancelled:
                                        <span class="badge badge-secondary"><icon name="slash" /> Phụ huynh hủy</span>
                                        break;
                                    default:
                                        <span class="badge">@req.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-xs" style="max-width: 220px;">
                                @if (!string.IsNullOrEmpty(req.RejectionReason))
                                {
                                    <span class="text-danger">Lý do: @req.RejectionReason</span>
                                }
                                else if (!string.IsNullOrEmpty(req.Notes))
                                {
                                    <span class="text-muted">@req.Notes</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-xs text-muted">
                                @(req.DecidedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? req.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Reject -->
<div id="rejectModal" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="app-card" style="max-width: 480px; width: 90%; margin: auto; animation: popIn 0.2s cubic-bezier(.34,1.56,.64,1);">
        <div class="card-header bg-danger-subtle d-flex justify-between align-center">
            <h3 class="card-title text-base font-semibold text-danger d-flex align-center gap-2">
                <icon name="alert-triangle" /> Từ chối đơn xin nghỉ học
            </h3>
            <button type="button" class="btn btn-ghost btn-xs" onclick="closeRejectModal()">&times;</button>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Reject">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectRequestId" />

                <p class="text-sm mb-3">
                    Bạn đang từ chối đơn <strong id="rejectRequestCode"></strong> của học sinh <strong id="rejectStudentName"></strong>.
                </p>

                <div class="form-group mb-4">
                    <label class="form-label">Lý do từ chối (bắt buộc) <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="3" placeholder="Ví dụ: Trùng lịch thi kiểm tra giữa kỳ, phụ huynh vui lòng liên hệ trực tiếp với GVCN..." required></textarea>
                </div>

                <div class="d-flex justify-end gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="closeRejectModal()">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm">
                        <icon name="x" /> Xác nhận từ chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(id, code, name) {
            document.getElementById('rejectRequestId').value = id;
            document.getElementById('rejectRequestCode').textContent = code;
            document.getElementById('rejectStudentName').textContent = name;
            const modal = document.getElementById('rejectModal');
            modal.style.display = 'flex';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }
    </script>
}
